# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Токен от @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Username бота (без @)
BOT_USERNAME=my_channel_comments_bot

# Ваш Telegram ID для уведомлений (узнать: @userinfobot)
ADMIN_CHAT_ID=123456789

# ID группы обсуждения канала (отрицательное число, начинается с -100)
GROUP_IDS=-1001234567890

# Время на ответ капчи
CAPTCHA_TIMEOUT=5m
